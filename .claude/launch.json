{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "C:\\Ruby33-x64\\bin\\ruby.exe",
      "runtimeArgs": ["bin/rails", "server", "-p", "3000"],
      "cwd": "backend",
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 5173
    },
    {
      "name": "api-alt",
      "runtimeExecutable": "C:\\Ruby33-x64\\bin\\ruby.exe",
      "runtimeArgs": ["bin/rails", "server", "-p", "3001", "-P", "tmp/pids/server-3001.pid"],
      "cwd": "backend",
      "port": 3001
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5180"],
      "cwd": "frontend",
      "port": 5180,
      "env": { "API_URL": "http://localhost:3001" }
    }
  ]
}
